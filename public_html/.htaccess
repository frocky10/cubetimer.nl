# ============================================================================
# CubeTimer - .htaccess
# Werkt op Apache en LiteSpeed (DirectAdmin). Elk blok staat in een
# <IfModule>, zodat een ontbrekende module de site niet omlaag haalt.
# ============================================================================

# Geen directorylisting.
Options -Indexes

# Eigen foutpagina; de server stuurt er nog steeds een echte 404 bij.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Eén adres: https://cubetimer.nl ------------------------------------
    # Zoekmachines zien http://, www. en de variant zonder www anders als drie
    # sites met dezelfde inhoud. Alles gaat met een 301 naar het ene adres.

    # www.cubetimer.nl -> https://cubetimer.nl
    RewriteCond %{HTTP_HOST} ^www\.cubetimer\.nl$ [NC]
    RewriteRule ^ https://cubetimer.nl%{REQUEST_URI} [R=301,L,NE]

    # http:// -> https://. X-Forwarded-Proto voor als er een proxy (Cloudflare
    # e.d.) voor zit; zonder die controle kan dat een oneindige lus geven. Alleen
    # op het echte domein, zodat een testadres of IP-adres niet wordt omgeleid.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} ^cubetimer\.nl$ [NC]
    RewriteRule ^ https://cubetimer.nl%{REQUEST_URI} [R=301,L,NE]

    # /index.html heet voortaan gewoon /. THE_REQUEST kijkt naar wat de
    # bezoeker vroeg, niet naar de interne DirectoryIndex; anders een lus.
    # De querystring (?oefen=OLL-27) gaat vanzelf mee.
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # Nette profiel-URL's: /u/naam komt uit bij profiel.php?u=naam.
    # Werkt hij niet (bijvoorbeeld omdat mod_rewrite uitstaat), dan blijft
    # /profiel.php?u=naam gewoon werken.
    RewriteRule ^u/([A-Za-z0-9_.-]{3,32})/?$ profiel.php?u=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    # Profielen en foutpagina's horen niet in zoekmachines (ook als een
    # crawler de HTML niet leest). profiel.php zet de header zelf ook.
    <FilesMatch "^(404\.html|profiel\.php)$">
        Header set X-Robots-Tag "noindex, follow"
    </FilesMatch>
</IfModule>

# --- Snelheid (telt mee voor Google) ------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml \
        application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Plaatjes en lettertypes veranderen vrijwel nooit: een maand in de cache.
# CSS, JS en HTML bewust niet lang: er zit geen versienummer in de
# bestandsnamen, dus na een release moet de browser het nieuwe bestand halen.
# Hij vraagt dan kort na (ETag) en krijgt een 304 als er niets veranderd is.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
